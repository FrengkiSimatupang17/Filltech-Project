                                        </div>
                                        
                                        <div className="text-sm text-gray-600 mt-2 border-t border-gray-100 pt-2 grid grid-cols-2 gap-2">
                                            <div>
                                                <span className="text-xs text-gray-400 block">RT / RW</span>
